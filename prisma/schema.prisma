// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  role       String   // "Student" or "Staff"
  name       String?  // Full name (optional for backward compat)
  department String?  // e.g. "Water", "Electrical" — Staff only
  zone       String?  // e.g. "Zone A", "Zone B"   — Staff only
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Otp {
  id         String   @id @default(cuid())
  email      String
  code       String
  role       String
  password   String
  name       String?
  department String?
  zone       String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}
