# ---------- Server ----------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# ---------- Database ----------
# Use a MongoDB Atlas / local URI, e.g. mongodb://127.0.0.1:27017/iitr_complaints
# "memory" = built-in local MongoDB saved in server/.mongo-data (seeded on first run, data kept).
MONGO_URI=memory

# ---------- Auth ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Leave empty to let any email register as a student.
# Set e.g. STUDENT_EMAIL_DOMAIN=iitr.ac.in to allow only institute emails.
STUDENT_EMAIL_DOMAIN=

# ---------- Email (Gmail SMTP: use an App Password) ----------
# Leave SMTP_HOST empty to print emails (and OTPs) to the server console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="IITR Complaint Portal <no-reply@iitr.ac.in>"

# ---------- Image uploads (Cloudinary) ----------
# Leave empty to store uploads on local disk in server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------- SLA ----------
SLA_ASSIGN_HOURS=24
SLA_AUTO_CLOSE_DAYS=3
SLA_REOPEN_DAYS=7

# ---------- Recurring problems ----------
# Flag a location + category after this many complaints within the window
RECURRING_THRESHOLD=3
RECURRING_WINDOW_DAYS=30
